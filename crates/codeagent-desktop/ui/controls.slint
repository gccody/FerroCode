import { ScrollView } from "std-widgets.slint";
import { AttachmentRow, ChangeRow, FileRow, OpenMethodRow } from "types.slint";
import { ComposerChevron, PaperclipMark } from "icons.slint";

export component ContextIndicator inherits Rectangle {
    in property <string> label;
    in property <int> percent: 0;
    in property <string> progress-path;
    private property <string> tooltip-label: label == ""
        ? "Context usage will appear after the first model response"
        : label;

    width: 34px;
    height: 34px;
    background: transparent;
    accessible-role: text;
    accessible-label: label == "" ? "Context usage unavailable" : label;

    Rectangle {
        x: 2px; y: 2px;
        width: 30px; height: 30px;
        border-radius: 15px;
        border-width: 2px;
        border-color: #353740;
        background: transparent;
    }
    if root.progress-path != "": Path {
        x: 2px; y: 2px;
        width: 30px; height: 30px;
        commands: root.progress-path;
        viewbox-width: 20; viewbox-height: 20;
        fill: transparent;
        stroke: root.percent >= 90 ? #e56671 : root.percent >= 75 ? #d6a54b : #9178e8;
        stroke-width: 2px;
        stroke-line-cap: round;
    }
    Text {
        x: 2px; y: 2px;
        width: 30px; height: 30px;
        text: root.label == "" ? "" : root.percent;
        color: #b9bbc5;
        font-size: 10px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Tooltip {
        text: @markdown("\{root.tooltip-label}");
    }
}

export component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    height: 30px;
    min-width: 52px;
    border-radius: 7px;
    background: !enabled ? #202126 : primary ? #634bb9 : selected ? #33343a : touch.has-hover ? #35363c : #26272c;
    border-width: primary ? 0px : 1px;
    border-color: danger ? #d75c68 : #35373d;
    Text {
        x: 9px; width: parent.width - 18px;
        text: root.text;
        color: !root.enabled ? #666871 : danger ? #f17b86 : #c8c9ce;
        font-size: 12px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
        overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

export component ToggleSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);
    width: 38px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: checked ? #8068cf : #45474f;
    background: checked ? #59469b : #292a30;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.checked ? #f0ecff : #a6a8b0;
    }
    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

export component ComposerEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    out property <length> content-height: input.preferred-height;
    callback key-pressed(KeyEvent) -> EventResult;
    accessible-role: text-input;
    accessible-enabled: enabled;
    accessible-value: text;
    accessible-placeholder-text: placeholder-text;
    clip: true;

    Text {
        x: 1px; y: 1px; width: parent.width - 2px; height: 20px;
        text: root.text == "" ? root.placeholder-text : "";
        color: #a3a5ad;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    edit-scroll := ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, input.preferred-height);
        horizontal-scrollbar-policy: always-off;
        vertical-scrollbar-policy: as-needed;

        input := TextInput {
            enabled: root.enabled;
            color: #e2e2e5;
            font-size: 12px;
            wrap: word-wrap;
            single-line: false;
            page-height: edit-scroll.visible-height;
            key-pressed(event) => { root.key-pressed(event) }
            cursor-position-changed(position) => {
                if position.y + edit-scroll.viewport-y < 0px {
                    edit-scroll.viewport-y = min(
                        0px,
                        edit-scroll.visible-height - position.y - 20px,
                        max(edit-scroll.visible-height - self.height, 0px - position.y)
                    );
                } else if position.y + edit-scroll.viewport-y > edit-scroll.visible-height - 20px {
                    edit-scroll.viewport-y = min(
                        0px,
                        max(
                            edit-scroll.visible-height - self.height,
                            edit-scroll.visible-height - position.y - 20px
                        )
                    );
                }
            }
        }
    }
}

export component AttachmentPreview inherits Rectangle {
    in property <AttachmentRow> attachment;
    callback remove(int);
    width: attachment.image ? 92px : 150px;
    height: 66px;
    border-radius: 8px;
    background: #222329;
    border-width: 1px;
    border-color: #3a3c44;
    clip: true;

    if attachment.image: Image {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        source: attachment.preview;
        image-fit: cover;
    }
    if !attachment.image: Rectangle {
        x: 8px; y: 11px; width: 32px; height: 42px;
        border-radius: 4px; background: #343640;
        Text { text: "FILE"; color: #b7b9c2; font-size: 8px; horizontal-alignment: TextHorizontalAlignment.center; vertical-alignment: TextVerticalAlignment.center; }
    }
    if !attachment.image: Text {
        x: 48px; y: 7px; width: parent.width - 58px; height: parent.height - 14px;
        text: attachment.name; color: #dedfe4; font-size: 11px;
        wrap: word-wrap; overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: parent.width - 22px; y: 4px; width: 18px; height: 18px;
        border-radius: 9px; background: remove-touch.has-hover ? #d75c68 : #202126dd;
        Text { text: "×"; color: #ffffff; font-size: 14px; horizontal-alignment: TextHorizontalAlignment.center; vertical-alignment: TextVerticalAlignment.center; }
        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.remove(root.attachment.index); } }
    }
}

// The composer toolbar uses a softer, rounded treatment without changing the
// compact actions elsewhere in the application.
export component ComposerAttachButton inherits Rectangle {
    in property <bool> enabled: true;
    callback clicked;

    width: 82px;
    height: 34px;
    border-radius: 7px;
    border-width: 1px;
    border-color: #35373d;
    background: !enabled ? #202126 : touch.pressed ? #202126 : touch.has-hover ? #35363c : #26272c;
    accessible-role: button;
    accessible-label: "Attach";
    accessible-enabled: enabled;

    PaperclipMark {
        x: 11px;
        y: (parent.height - self.height) / 2;
    }
    Text {
        x: 34px;
        width: parent.width - self.x - 11px;
        text: "Attach";
        color: root.enabled ? #ffffff : #797b83;
        font-size: 12px;
        vertical-alignment: TextVerticalAlignment.center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.clicked(); }
    }
}

export component ComposerComboBox inherits Rectangle {
    in property <[string]> model;
    in property <bool> enabled: true;
    in-out property <int> current-index: 0;
    callback selected(string);

    private property <string> current-value: model.length > 0 && current-index >= 0 && current-index < model.length
        ? model[current-index]
        : "";
    private property <int> visible-items: min(6, model.length);

    height: 34px;
    border-radius: 7px;
    border-width: 1px;
    border-color: #35373d;
    background: !enabled ? #202126 : select-touch.pressed ? #202126 : select-touch.has-hover ? #35363c : #26272c;
    forward-focus: select-focus;
    accessible-role: combobox;
    accessible-enabled: enabled;
    accessible-expandable: true;
    accessible-value: current-value;
    accessible-action-expand => { root.open-popup(); }

    public function choose(index: int) {
        if !root.enabled || index < 0 || index >= root.model.length {
            return;
        }
        root.current-index = index;
        root.selected(root.model[index]);
        select-popup.close();
    }

    public function open-popup() {
        if root.enabled && root.model.length > 0 {
            select-popup.show();
        }
    }

    Text {
        x: 11px;
        width: parent.width - 39px;
        text: root.current-value;
        color: root.enabled ? #ffffff : #797b83;
        font-size: 12px;
        vertical-alignment: TextVerticalAlignment.center;
        overflow: elide;
    }
    ComposerChevron {
        x: parent.width - self.width - 11px;
        y: (parent.height - self.height) / 2;
    }
    select-focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.UpArrow {
                root.choose(max(0, root.current-index - 1));
                return accept;
            } else if event.text == Key.DownArrow {
                root.choose(min(root.model.length - 1, root.current-index + 1));
                return accept;
            } else if event.text == Key.Return || event.text == Key.Space {
                root.open-popup();
                return accept;
            }
            return reject;
        }
        select-touch := TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => {
                select-focus.focus();
                root.open-popup();
            }
        }
    }

    select-popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        height: root.visible-items * 32px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: 7px;
            border-width: 1px;
            border-color: #3b3d44;
            background: #202126;

            ScrollView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                horizontal-scrollbar-policy: always-off;

                VerticalLayout {
                    spacing: 2px;
                    for value[index] in root.model: Rectangle {
                        height: 30px;
                        border-radius: 5px;
                        background: index == root.current-index ? #3a3355 : option-touch.has-hover ? #35363c : transparent;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: value;
                            color: #f0f0f2;
                            font-size: 12px;
                            vertical-alignment: TextVerticalAlignment.center;
                            overflow: elide;
                        }
                        option-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.choose(index); }
                        }
                    }
                }
            }
        }
    }
}

export component OpenProjectButton inherits Rectangle {
    in property <[OpenMethodRow]> methods;
    in property <bool> enabled: true;
    callback selected(string);

    private property <int> visible-items: min(7, root.methods.length);

    width: 94px;
    height: 30px;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.enabled ? #3a3c43 : #2a2b30;
    background: !root.enabled ? #15161a : open-touch.pressed ? #202126 : open-touch.has-hover ? #292a30 : #191a1e;
    accessible-role: button;
    accessible-label: "Open project in";
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-action-expand => { root.open-menu(); }

    public function open-menu() {
        if root.enabled && root.methods.length > 0 {
            open-popup.show();
        }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 9px;
        spacing: 7px;
        Text {
            text: "Open in";
            color: root.enabled ? #d9dae0 : #696b72;
            font-size: 11px;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Rectangle { horizontal-stretch: 1; }
        ComposerChevron { y: (parent.height - self.height) / 2; }
    }
    open-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.open-menu(); }
    }

    open-popup := PopupWindow {
        x: root.width - self.width;
        y: root.height + 4px;
        width: 190px;
        height: root.visible-items * 34px + 8px;
        close-policy: close-on-click-outside;

        Rectangle {
            border-radius: 7px;
            border-width: 1px;
            border-color: #3b3d44;
            background: #202126;

            ScrollView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                horizontal-scrollbar-policy: always-off;

                VerticalLayout {
                    spacing: 2px;
                    for method in root.methods: Rectangle {
                        height: 32px;
                        border-radius: 5px;
                        background: method-touch.has-hover ? #35363c : transparent;
                        if method.has-icon: Image {
                            x: 9px;
                            y: (parent.height - self.height) / 2;
                            width: 18px;
                            height: 18px;
                            source: method.icon;
                            image-fit: contain;
                        }
                        Text {
                            x: method.has-icon ? 35px : 10px;
                            width: parent.width - self.x - 10px;
                            text: method.label;
                            color: #f0f0f2;
                            font-size: 12px;
                            vertical-alignment: TextVerticalAlignment.center;
                            overflow: elide;
                        }
                        method-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.selected(method.label);
                                open-popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component SectionTitle inherits Text {
    color: #9799a1;
    font-size: 12px;
}

export component ChangeMetric inherits Rectangle {
    in property <string> value;
    in property <string> label;
    height: 47px;
    horizontal-stretch: 1;
    border-radius: 6px;
    background: #191a1e;
    border-width: 1px;
    border-color: #292b31;
    Text {
        x: 8px; y: 6px; width: parent.width - 16px; height: 18px;
        text: root.value;
        color: #eeeaff;
        font-size: 13px;
        font-weight: 600;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 5px; y: 25px; width: parent.width - 10px; height: 14px;
        text: root.label;
        color: #777982;
        font-size: 8px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

export component ChangeFileRow inherits Rectangle {
    in property <ChangeRow> change;
    height: 50px;
    border-radius: 6px;
    background: change-touch.has-hover ? #1a1b20 : transparent;

    Rectangle {
        x: 7px; y: 12px; width: 26px; height: 26px;
        border-radius: 5px;
        background: root.change.status == "A" ? #19372b
            : root.change.status == "D" ? #3a2025
            : root.change.status == "!" ? #40242a
            : root.change.status == "R" ? #252d43
            : root.change.status == "U" ? #20362f
            : #3a311f;
        border-width: 1px;
        border-color: root.change.status == "A" ? #2d694e
            : root.change.status == "D" ? #70404a
            : root.change.status == "!" ? #8b4653
            : root.change.status == "R" ? #41547d
            : root.change.status == "U" ? #35705b
            : #735f32;
        Text {
            text: root.change.status;
            color: root.change.status == "A" ? #72d7a3
                : root.change.status == "D" ? #ef8994
                : root.change.status == "!" ? #ff9ca6
                : root.change.status == "R" ? #8eb1ef
                : root.change.status == "U" ? #7bd9ad
                : #e6bd62;
            font-size: 10px;
            font-weight: 700;
            horizontal-alignment: TextHorizontalAlignment.center;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }
    Text {
        x: 41px; y: 7px; width: parent.width - 94px; height: 19px;
        text: root.change.name;
        color: #d9dae0;
        font-size: 10px;
        font-weight: 500;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: 41px; y: 26px; width: parent.width - 49px; height: 16px;
        text: root.change.detail;
        color: #777982;
        font-size: 8px;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Text {
        x: parent.width - 55px; y: 8px; width: 47px; height: 17px;
        text: root.change.state-label;
        color: #8f919b;
        font-size: 7px;
        font-weight: 600;
        horizontal-alignment: TextHorizontalAlignment.right;
        vertical-alignment: TextVerticalAlignment.center;
    }
    change-touch := TouchArea {
        mouse-cursor: default;
        accessible-role: text;
        accessible-label: root.change.status-label + ": " + root.change.name + ", " + root.change.state-label;
    }
}

export component FileTreeNode inherits Rectangle {
    in property <FileRow> node;
    in property <length> tree-origin: 13px;
    height: 26px;
    background: transparent;

    property <length> branch-x: node.depth * 16px + tree-origin;

    // Keep each open ancestor branch running behind nested descendants.
    if node.guide0: Rectangle { x: root.tree-origin; width: 1px; height: parent.height; background: #50525a; }
    if node.guide1: Rectangle { x: root.tree-origin + 16px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide2: Rectangle { x: root.tree-origin + 32px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide3: Rectangle { x: root.tree-origin + 48px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide4: Rectangle { x: root.tree-origin + 64px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide5: Rectangle { x: root.tree-origin + 80px; width: 1px; height: parent.height; background: #50525a; }

    // Rust resolves the sibling relationship. The renderer only draws the
    // resulting connector, avoiding conditionals inside virtualized rows.
    Rectangle {
        x: root.branch-x;
        y: 0px;
        width: 1px;
        height: root.node.connector-height * 1px;
        background: #50525a;
    }
    Rectangle { x: root.branch-x; y: 12px; width: 12px; height: 1px; background: #50525a; }

    Text {
        x: root.branch-x + 14px;
        width: parent.width - self.x;
        text: root.node.name;
        color: root.node.changed ? #ff8f9c : root.node.directory ? #dcdee4 : #aeb0b8;
        font-size: 10px;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

export component InspectorTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    accessible-role: button;
    accessible-label: text;
    height: 30px;
    horizontal-stretch: 1;
    border-radius: 5px;
    background: selected ? #2c2740 : tab-touch.has-hover ? #24252a : transparent;
    Text {
        text: root.text;
        color: root.selected ? #ddd5ff : #9799a1;
        font-size: 9px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        visible: root.selected;
        x: 7px; y: parent.height - 2px;
        width: parent.width - 14px; height: 2px;
        border-radius: 1px;
        background: #8068cf;
    }
    tab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
