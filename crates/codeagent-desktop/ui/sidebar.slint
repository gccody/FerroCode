import { LineEdit, ScrollView } from "std-widgets.slint";
import { ProjectRow, ThreadRow } from "types.slint";
import {
    ChevronDown, ChevronRight, CloseMark, CompletedMark, NewChatMark, PlusMark,
    SettingsCog, SidebarMark, WorkingMark,
} from "icons.slint";

export component Sidebar inherits Rectangle {
    in property <[ProjectRow]> projects;
    in property <[ThreadRow]> threads;
    in-out property <bool> expanded: true;
    in property <length> available-width: 1440px;
    in-out property <length> expanded-width: 247px;
    in-out property <string> search-text: "";
    in property <int> visible-thread-limit: 5;
    in-out property <bool> show-all-threads: false;
    private property <length> minimum-expanded-width: 150px;
    private property <length> maximum-expanded-width: 600px;

    callback add-project;
    callback toggle-project(string);
    callback new-thread-for-project(string);
    callback open-thread(string);
    callback archive-thread(string);
    callback search-threads(string);
    callback open-settings;

    width: root.expanded ? root.expanded-width : 53px;
    background: #0f1012;
    border-width: 1px;
    border-color: #292a2f;

    VerticalLayout {
        padding-left: 12px; padding-right: 12px; padding-top: 9px; padding-bottom: 7px;
        spacing: 7px;

        HorizontalLayout {
            height: 28px;
            spacing: 7px;
            Rectangle {
                width: 28px; height: 28px;
                border-radius: 6px;
                background: sidebar-toggle-touch.has-hover ? #24252a : transparent;
                accessible-role: button;
                accessible-label: root.expanded ? "Collapse sidebar" : "Expand sidebar";
                SidebarMark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                sidebar-toggle-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.expanded = !root.expanded; }
                }
            }
            if root.expanded: LineEdit {
                height: 28px;
                text <=> root.search-text;
                placeholder-text: "Search";
                edited(text) => { root.search-threads(text); }
            }
        }

        if root.expanded: VerticalLayout {
            vertical-stretch: 1;
            spacing: 7px;

            Rectangle { height: 14px; }
            HorizontalLayout {
                height: 22px;
                Text { text: "Projects"; color: #9799a1; font-size: 12px; vertical-alignment: TextVerticalAlignment.center; }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 24px;
                    PlusMark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    add-project-touch := TouchArea { mouse-cursor: pointer; clicked => { root.add-project(); } }
                }
            }

            ScrollView {
                vertical-stretch: 1;
                viewport-width: self.width;
                horizontal-scrollbar-policy: always-off;
                VerticalLayout {
                    width: parent.width;
                    spacing: 2px;
                    for project in root.projects: VerticalLayout {
                        spacing: 1px;
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: project-touch.has-hover ? #1b1c20 : transparent;
                            if !project.collapsed: ChevronDown { x: 5px; y: 15px; }
                            if project.collapsed: ChevronRight { x: 7px; y: 13px; }
                            Text {
                                x: 28px;
                                width: parent.width - 56px;
                                text: project.name;
                                color: #e8e8eb;
                                font-size: 12px;
                                horizontal-alignment: TextHorizontalAlignment.center;
                                vertical-alignment: TextVerticalAlignment.center;
                                overflow: elide;
                            }
                            project-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.toggle-project(project.id); }
                            }
                            Rectangle {
                                x: parent.width - 32px; y: 5px;
                                width: 28px; height: 28px;
                                border-radius: 5px;
                                background: new-chat-touch.has-hover ? #34353a : transparent;
                                accessible-role: button;
                                accessible-label: "New chat in " + project.name;
                                NewChatMark {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                                new-chat-touch := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.new-thread-for-project(project.id); }
                                }
                            }
                        }
                        for thread in root.threads: Rectangle {
                            private property <bool> shown: thread.project-id == project.id
                                && !project.collapsed
                                && (root.show-all-threads || thread.project-index < root.visible-thread-limit);
                            private property <bool> has-accessory: thread.active || thread.busy || thread.completed-unread;
                            visible: self.shown;
                            height: self.shown ? 42px : 0px;
                            x: 17px;
                            width: parent.width - 17px;
                            border-radius: 7px;
                            background: thread.active ? #202126 : thread-touch.has-hover ? #18191c : transparent;
                            Rectangle { x: -9px; width: 1px; height: parent.height; background: #303138; }
                            Text {
                                x: 20px;
                                width: parent.width - 20px - (thread.age-label == "" ? (parent.has-accessory ? 38px : 8px) : (parent.has-accessory ? 94px : 64px));
                                text: thread.title;
                                color: thread.active ? #f0f0f2 : #9a9ca4;
                                font-size: 12px;
                                vertical-alignment: TextVerticalAlignment.center;
                                overflow: elide;
                            }
                            if thread.age-label != "": Text {
                                x: parent.width - (parent.has-accessory ? 88px : 58px);
                                width: 50px;
                                text: thread.age-label;
                                color: #686a72;
                                font-size: 10px;
                                horizontal-alignment: TextHorizontalAlignment.right;
                                vertical-alignment: TextVerticalAlignment.center;
                            }
                            if thread.busy: WorkingMark { x: parent.width - 24px; y: 13px; }
                            if thread.completed-unread && !thread.busy: CompletedMark { x: parent.width - 22px; y: 14px; }
                            thread-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-thread(thread.id); } }
                            if thread.active && !thread.busy && !thread.completed-unread: Rectangle {
                                x: parent.width - 33px; y: 7px; width: 26px; height: 28px;
                                border-radius: 5px; background: close-touch.has-hover ? #34353a : transparent;
                                CloseMark { x: 7px; y: 8px; }
                                close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.archive-thread(thread.id); } }
                            }
                        }
                        if !project.collapsed && project.thread-count > root.visible-thread-limit: Rectangle {
                            height: 30px;
                            x: 17px;
                            width: parent.width - 17px;
                            border-radius: 6px;
                            background: thread-list-toggle-touch.has-hover ? #1b1c20 : transparent;
                            Text {
                                text: root.show-all-threads ? "Show less" : "Show more";
                                color: #a995ff;
                                font-size: 11px;
                                horizontal-alignment: TextHorizontalAlignment.center;
                                vertical-alignment: TextVerticalAlignment.center;
                            }
                            thread-list-toggle-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.show-all-threads = !root.show-all-threads; }
                            }
                        }
                    }
                }
            }

            Rectangle { height: 1px; background: #292a2f; }
            Rectangle {
                height: 36px;
                border-radius: 6px;
                background: settings-touch.has-hover ? #1d1e22 : transparent;
                HorizontalLayout {
                    alignment: LayoutAlignment.center;
                    spacing: 10px;
                    SettingsCog { y: (parent.height - self.height) / 2; }
                    Text { text: "Settings"; color: #d7d8dc; font-size: 13px; vertical-alignment: TextVerticalAlignment.center; }
                }
                settings-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-settings(); } }
            }
        }
        if !root.expanded: Rectangle { vertical-stretch: 1; }
        if !root.expanded: Rectangle {
            height: 36px;
            border-radius: 6px;
            background: collapsed-settings-touch.has-hover ? #1d1e22 : transparent;
            accessible-role: button;
            accessible-label: "Settings";
            SettingsCog {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            collapsed-settings-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.open-settings(); }
            }
        }
    }

    if root.expanded: resize-handle := Rectangle {
        x: parent.width - self.width;
        width: 6px;
        background: resize-touch.has-hover || resize-touch.pressed ? #6f5bd3 : transparent;
        accessible-role: slider;
        accessible-label: "Resize sidebar";

        resize-touch := TouchArea {
            mouse-cursor: ew-resize;
            moved => {
                if (self.pressed && root.available-width > 0px) {
                    root.expanded-width = max(
                        root.minimum-expanded-width,
                        min(
                            min(root.maximum-expanded-width, root.available-width - 400px),
                            root.width + self.mouse-x - self.pressed-x,
                        ),
                    );
                }
            }
        }
    }
}
