import { ComboBox, LineEdit, ListView, ScrollView, Spinner } from "std-widgets.slint";

export struct ProjectRow { id: string, name: string, path: string, active: bool }
export struct ThreadRow { id: string, project-id: string, title: string, subtitle: string, active: bool, busy: bool }
export struct MarkdownTableCell { text: styled-text, alignment: string, column-width: length }
export struct MarkdownTableRow { cells: [MarkdownTableCell], header: bool, row-height: length }
export struct MarkdownBlock {
    kind: string, text: styled-text, raw-text: string, language: string, level: int,
    block-height: length, column-count: int, table-width: length, table-height: length,
    table-rows: [MarkdownTableRow]
}
export struct MessageRow {
    id: string, kind: string, title: string, body: string, markdown-blocks: [MarkdownBlock], status: string,
    user: bool, activity: bool, row-height: length
}
export struct FileRow {
    name: string, depth: int, directory: bool, changed: bool, connector-height: int,
    guide0: bool, guide1: bool, guide2: bool, guide3: bool, guide4: bool, guide5: bool
}
export struct QuestionRow {
    index: int, header: string, question: string, answer: string, secret: bool,
    option-count: int, option-a: string, option-b: string, option-c: string
}
export struct AttachmentRow { index: int, name: string, preview: image, image: bool }

component BrandMark inherits Rectangle {
    width: 18px; height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: #7658db;
    Rectangle { width: 5px; height: 5px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 3px; background: #a893ff; }
}

component PlusMark inherits Path {
    width: 14px; height: 14px;
    commands: "M 7 1 L 7 13 M 1 7 L 13 7";
    viewbox-width: 14; viewbox-height: 14;
    fill: transparent; stroke: #aeb0b8; stroke-width: 1.8px;
    stroke-line-cap: round;
}

component MenuMark inherits Path {
    width: 15px; height: 13px;
    commands: "M 1 2 L 14 2 M 1 6.5 L 14 6.5 M 1 11 L 14 11";
    viewbox-width: 15; viewbox-height: 13;
    fill: transparent; stroke: #aeb0b8; stroke-width: 1.8px;
    stroke-line-cap: round;
}

component CopyMark inherits Path {
    width: 14px; height: 14px;
    commands: "M 9 9 H 22 V 22 H 9 Z M 5 15 H 2 V 2 H 15 V 5";
    viewbox-width: 24; viewbox-height: 24;
    fill: transparent; stroke: #aeb0b8; stroke-width: 2px;
    stroke-line-cap: round; stroke-line-join: round;
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    height: 30px;
    min-width: 52px;
    border-radius: 7px;
    background: !enabled ? #202126 : primary ? #634bb9 : selected ? #33343a : touch.has-hover ? #35363c : #26272c;
    border-width: primary ? 0px : 1px;
    border-color: danger ? #d75c68 : #35373d;
    Text {
        x: 9px; width: parent.width - 18px;
        text: root.text;
        color: !root.enabled ? #666871 : danger ? #f17b86 : #c8c9ce;
        font-size: 12px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
        overflow: elide;
    }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

component ToggleSwitch inherits Rectangle {
    in property <bool> checked: false;
    in property <string> label;
    callback toggled(bool);
    width: 38px;
    height: 20px;
    border-radius: 10px;
    border-width: 1px;
    border-color: checked ? #8068cf : #45474f;
    background: checked ? #59469b : #292a30;
    accessible-role: button;
    accessible-label: label;
    Rectangle {
        x: root.checked ? 19px : 3px;
        y: 3px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: root.checked ? #f0ecff : #a6a8b0;
    }
    toggle-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

component FlatButton inherits Rectangle {
    in property <string> text;
    in property <bool> plus-icon: false;
    in property <bool> enabled: true;
    callback clicked;
    accessible-role: button;
    accessible-label: text;
    accessible-enabled: enabled;
    height: 36px;
    border-radius: 6px;
    background: touch.has-hover && enabled ? #1d1e22 : transparent;
    if root.plus-icon: PlusMark { x: 10px; y: (parent.height - self.height) / 2; }
    Text { x: root.plus-icon ? 34px : 9px; width: parent.width - self.x - 8px; text: root.text; color: root.enabled ? #d7d8dc : #73757d; font-size: 13px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
    touch := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? pointer : default; clicked => { root.clicked(); } }
}

component ComposerEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <bool> enabled: true;
    callback key-pressed(KeyEvent) -> EventResult;
    accessible-role: text-input;
    accessible-enabled: enabled;
    accessible-value: text;
    accessible-placeholder-text: placeholder-text;
    clip: true;

    Text {
        x: 1px; y: 1px; width: parent.width - 2px; height: 20px;
        text: root.text == "" ? root.placeholder-text : "";
        color: #a3a5ad;
        font-size: 12px;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    input := TextInput {
        width: parent.width; height: parent.height;
        enabled: root.enabled;
        color: #e2e2e5;
        font-size: 12px;
        wrap: word-wrap;
        single-line: false;
        key-pressed(event) => { root.key-pressed(event) }
    }
}

component AttachmentPreview inherits Rectangle {
    in property <AttachmentRow> attachment;
    callback remove(int);
    width: attachment.image ? 92px : 150px;
    height: 66px;
    border-radius: 8px;
    background: #222329;
    border-width: 1px;
    border-color: #3a3c44;
    clip: true;

    if attachment.image: Image {
        x: 1px; y: 1px; width: parent.width - 2px; height: parent.height - 2px;
        source: attachment.preview;
        image-fit: cover;
    }
    if !attachment.image: Rectangle {
        x: 8px; y: 11px; width: 32px; height: 42px;
        border-radius: 4px; background: #343640;
        Text { text: "FILE"; color: #b7b9c2; font-size: 8px; horizontal-alignment: TextHorizontalAlignment.center; vertical-alignment: TextVerticalAlignment.center; }
    }
    if !attachment.image: Text {
        x: 48px; y: 7px; width: parent.width - 58px; height: parent.height - 14px;
        text: attachment.name; color: #dedfe4; font-size: 11px;
        wrap: word-wrap; overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        x: parent.width - 22px; y: 4px; width: 18px; height: 18px;
        border-radius: 9px; background: remove-touch.has-hover ? #d75c68 : #202126dd;
        Text { text: "×"; color: #ffffff; font-size: 14px; horizontal-alignment: TextHorizontalAlignment.center; vertical-alignment: TextVerticalAlignment.center; }
        remove-touch := TouchArea { mouse-cursor: pointer; clicked => { root.remove(root.attachment.index); } }
    }
}

component MessageCard inherits Rectangle {
    in property <MessageRow> message;
    callback copy-code(string);
    horizontal-stretch: 1;
    height: message.row-height;
    background: transparent;

    if message.user: Rectangle {
        // Use the renderer's proportional-font measurement so every bubble
        // has exactly 14 px of horizontal padding, including short messages.
        width: min(bubble-text.preferred-width + 28px, min(650px, parent.width - 18px));
        height: parent.height - 10px;
        x: parent.width - self.width - 8px;
        y: 5px;
        border-radius: 14px;
        background: #222226;
        border-width: 1px;
        border-color: #303137;
        bubble-text := Text {
            x: 14px; y: 8px; width: parent.width - 28px; height: parent.height - 16px;
            text: message.body;
            color: #e8e8eb;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }

    if message.activity: Rectangle {
        x: 8px; width: parent.width - 16px; height: parent.height;
        Path {
            x: 4px; y: (parent.height - 12px) / 2; width: 11px; height: 12px;
            commands: message.status == "running" ? "M 1 2 L 4.5 6 L 8 2" : "M 2 1 L 6 5 L 2 9";
            viewbox-width: 10; viewbox-height: 10; fill: transparent; stroke: #9a9ca4; stroke-width: 1.7px;
            stroke-line-cap: round; stroke-line-join: round;
        }
        Text { x: 26px; width: parent.width - 74px; text: message.title; color: #989aa2; font-size: 12px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
        if message.status == "running": Spinner { x: parent.width - 25px; y: (parent.height - 14px) / 2; width: 14px; height: 14px; }
    }

    if !message.user && !message.activity: VerticalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 5px; padding-bottom: 5px;
        spacing: 7px;

        for block in message.markdown-blocks: Rectangle {
            height: block.block-height;
            background: transparent;

            if block.kind == "paragraph": StyledText {
                width: parent.width; height: parent.height;
                text: block.text;
                default-color: message.kind == "reasoning" ? #aaabb2 : #f0f0f2;
                default-font-size: message.kind == "reasoning" ? 12px : 13px;
                link-color: message.kind == "reasoning" ? #a99ce0 : #a893ff;
                vertical-alignment: TextVerticalAlignment.top;
                link-clicked(link) => { Platform.open-url(link); }
            }

            if block.kind == "heading": StyledText {
                width: parent.width; height: parent.height;
                text: block.text;
                default-color: #f4f2fa;
                default-font-size: block.level == 1 ? 22px : block.level == 2 ? 19px : block.level == 3 ? 17px : block.level == 4 ? 15px : 14px;
                link-color: #b8a8ff;
                vertical-alignment: TextVerticalAlignment.center;
                link-clicked(link) => { Platform.open-url(link); }
            }

            if block.kind == "quote": Rectangle {
                width: parent.width; height: parent.height;
                background: #14151a;
                border-radius: 4px;
                Rectangle { x: 0px; width: 3px; height: parent.height; border-radius: 2px; background: #6f5bb4; }
                StyledText {
                    x: 13px; y: 7px; width: parent.width - 22px; height: parent.height - 14px;
                    text: block.text;
                    default-color: #bbb9c3;
                    default-font-size: message.kind == "reasoning" ? 12px : 13px;
                    link-color: #a893ff;
                    vertical-alignment: TextVerticalAlignment.top;
                    link-clicked(link) => { Platform.open-url(link); }
                }
            }

            if block.kind == "code": Rectangle {
                width: parent.width; height: parent.height;
                background: #17181d;
                border-width: 1px; border-color: #303138; border-radius: 6px;
                Text {
                    x: 10px; y: 1px; width: parent.width - 54px; height: 32px;
                    text: block.language;
                    color: #8f919a;
                    font-family: "Cascadia Mono";
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                    overflow: elide;
                }
                Rectangle {
                    x: parent.width - 35px; y: 5px; width: 28px; height: 24px;
                    border-radius: 5px;
                    background: copy-touch.has-hover ? #303138 : transparent;
                    border-width: 1px;
                    border-color: copy-touch.has-hover ? #474951 : transparent;
                    accessible-role: button;
                    accessible-label: "Copy code";
                    CopyMark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    copy-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy-code(block.raw-text); }
                    }
                }
                Rectangle { x: 1px; y: 33px; width: parent.width - 2px; height: 1px; background: #292a30; }
                Text {
                    x: 10px; y: 35px; width: parent.width - 20px; height: parent.height - 42px;
                    text: block.raw-text;
                    color: #d7d5de;
                    font-family: "Cascadia Mono";
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: TextVerticalAlignment.top;
                }
            }

            if block.kind == "rule": Rectangle {
                y: (parent.height - 1px) / 2; width: parent.width; height: 1px; background: #34353b;
            }

            if block.kind == "table": ScrollView {
                width: parent.width; height: parent.height;
                viewport-width: block.table-width;
                viewport-height: block.table-height;
                horizontal-scrollbar-policy: as-needed;
                vertical-scrollbar-policy: always-off;
                Rectangle {
                    width: block.table-width; height: block.table-height;
                    border-width: 1px; border-color: #393a42; border-radius: 10px;
                    clip: true;
                    VerticalLayout {
                        spacing: 0px;
                        for row[row-index] in block.table-rows: HorizontalLayout {
                            height: row.row-height;
                            spacing: 0px;
                            for cell[cell-index] in row.cells: Rectangle {
                                width: cell.column-width;
                                horizontal-stretch: 0;
                                border-width: 1px;
                                border-color: #393a42;
                                border-top-left-radius: row-index == 0 && cell-index == 0 ? 10px : 0px;
                                border-top-right-radius: row-index == 0 && cell-index == row.cells.length - 1 ? 10px : 0px;
                                border-bottom-left-radius: row-index == block.table-rows.length - 1 && cell-index == 0 ? 10px : 0px;
                                border-bottom-right-radius: row-index == block.table-rows.length - 1 && cell-index == row.cells.length - 1 ? 10px : 0px;
                                background: row.header ? #24212f : #15161a;
                                StyledText {
                                    x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                                    text: cell.text;
                                    default-color: row.header ? #f0ecff : #d2d2d7;
                                    default-font-size: 12px;
                                    link-color: #a893ff;
                                    horizontal-alignment: cell.alignment == "center" ? TextHorizontalAlignment.center : cell.alignment == "right" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                    vertical-alignment: TextVerticalAlignment.center;
                                    link-clicked(link) => { Platform.open-url(link); }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

