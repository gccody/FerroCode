import {
    AttachmentRow, ChangeRow, FileRow, MessageRow, OpenMethodRow, ProjectRow, QuestionRow, ThreadRow,
} from "types.slint";
import { AppHeader, UpdateBanner } from "app-chrome.slint";
import { ConversationPane } from "conversation-pane.slint";
import { InspectorPanel } from "inspector-panel.slint";
import { Sidebar } from "sidebar.slint";
import {
    ApprovalOverlay, LoadingOverlay, QuestionsOverlay, SettingsOverlay, ToastOverlay,
} from "overlays.slint";

export component MainWindow inherits Window {
    title: "CodeAgent";
    icon: @image-url("../assets/app-icon.png");
    no-frame: true;
    resize-border-width: root.maximized ? 0px : 6px;
    preferred-width: 1440px; preferred-height: 900px;
    min-width: 980px; min-height: 640px;
    background: #0d0e10;
    default-font-family: "Segoe UI";

    in property <[ProjectRow]> projects;
    in property <[ThreadRow]> threads;
    in property <[MessageRow]> messages;
    in property <int> message-revision: 0;
    in property <length> message-content-height: 0px;
    in property <[FileRow]> files;
    in property <[ChangeRow]> changes;
    in property <[string]> activity;
    in property <[string]> model-names;
    in property <[string]> effort-names;
    in property <[string]> sandbox-names;
    in property <[string]> approval-names;
    in property <[OpenMethodRow]> open-project-methods;
    in property <string> connection-text: "Starting Codex...";
    in property <bool> connected: false;
    in-out property <bool> startup-loading: true;
    in property <string> account-label: "";
    in property <string> plan-label: "";
    in property <string> workspace-path: "";
    in property <string> workspace-name: "Workspace";
    in property <string> active-thread-id: "";
    in property <string> active-thread-title: "New thread";
    in property <string> context-label: "";
    in property <string> context-progress-path: "";
    in property <string> usage-left-label: "";
    in property <int> context-percent: 0;
    in property <bool> busy: false;
    in property <string> turn-elapsed-label: "";
    in property <bool> has-project: false;
    in-out property <bool> sidebar-visible: true;
    private property <length> sidebar-expanded-width: 247px;
    in-out property <string> sidebar-search-text: "";
    in-out property <bool> inspector-visible: false;
    in-out property <int> inspector-tab: 0;
    in-out property <bool> settings-visible: false;
    in-out property <bool> respect-gitignore: true;
    in-out property <int> visible-thread-limit: 5;
    in-out property <bool> show-all-threads: false;
    in property <int> change-count: 0;
    in property <int> staged-change-count: 0;
    in property <int> unstaged-change-count: 0;
    in-out property <int> selected-model-index: 0;
    in-out property <int> selected-effort-index: 0;
    in-out property <int> selected-sandbox-index: 1;
    in-out property <int> default-model-index: 0;
    in-out property <int> default-effort-index: 0;
    in property <[string]> default-effort-names: [];
    in-out property <int> default-sandbox-index: 1;
    in-out property <int> selected-approval-index: 0;
    in-out property <int> summary-model-index: 0;
    in-out property <int> summary-effort-index: 0;
    in property <[string]> summary-effort-names: [];
    in property <string> usage-summary: "Usage information unavailable";
    in property <int> reset-count: 0;
    in property <bool> reset-in-progress: false;
    in property <string> approval-title: "";
    in property <string> approval-detail: "";
    in property <bool> approval-session: false;
    in property <[QuestionRow]> questions;
    in property <[AttachmentRow]> attachments;
    in property <string> toast-text: "";
    in property <bool> toast-error: false;
    in property <string> codex-update-version: "";
    in property <bool> codex-update-in-progress: false;

    callback add-project;
    callback open-project(string);
    callback select-project(string);
    callback toggle-project(string);
    callback new-thread;
    callback new-thread-for-project(string);
    callback open-thread(string);
    callback archive-thread(string);
    callback search-threads(string);
    callback send-message(string);
    callback stop-turn;
    callback attach-files;
    callback paste-image() -> bool;
    callback remove-attachment(int);
    callback copy-code(string);
    callback copy-response(string);
    callback toggle-message(string);
    callback toggle-response-details(string);
    callback select-model(string);
    callback select-effort(string);
    callback select-sandbox(string);
    callback select-default-model(string);
    callback select-default-effort(string);
    callback select-default-sandbox(string);
    callback select-approval(string);
    callback select-summary-model(string);
    callback select-summary-effort(string);
    callback answer-approval(string);
    callback answer-question(int, string);
    callback submit-question;
    callback refresh-usage;
    callback refresh-workspace;
    callback consume-reset;
    callback update-codex;
    callback set-inspector(bool);
    callback set-respect-gitignore(bool);
    callback set-visible-thread-limit(int);
    callback drag-window;

    public function clear-input-focus() {
        focus-sink.focus();
    }

    changed inspector-visible => { root.set-inspector(root.inspector-visible); }

    // Pointer presses move focus here before normal dispatch. An input that was
    // clicked will then take focus back; clicking anywhere else leaves it here.
    focus-sink := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
    }

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            usage-left-label: root.usage-left-label;
            connected: root.connected;
            connection-text: root.connection-text;
            maximized: root.maximized;
            drag-window => { root.drag-window(); }
            toggle-maximize => { root.maximized = !root.maximized; }
            minimize => { root.minimized = true; }
            close => { root.close(); }
        }

        if root.codex-update-version != "": UpdateBanner {
            visible: !root.startup-loading;
            version: root.codex-update-version;
            in-progress: root.codex-update-in-progress;
            update => { root.update-codex(); }
        }

        HorizontalLayout {
            visible: !root.startup-loading;
            spacing: 0px;

            Sidebar {
                projects: root.projects;
                threads: root.threads;
                expanded <=> root.sidebar-visible;
                available-width: root.width;
                expanded-width <=> root.sidebar-expanded-width;
                search-text <=> root.sidebar-search-text;
                visible-thread-limit: root.visible-thread-limit;
                show-all-threads <=> root.show-all-threads;
                add-project => { root.add-project(); }
                toggle-project(id) => { root.toggle-project(id); }
                new-thread-for-project(id) => { root.new-thread-for-project(id); }
                open-thread(id) => { root.open-thread(id); }
                archive-thread(id) => { root.archive-thread(id); }
                search-threads(text) => { root.search-threads(text); }
                open-settings => { root.settings-visible = true; }
            }

            ConversationPane {
                messages: root.messages;
                message-revision: root.message-revision;
                message-content-height: root.message-content-height;
                attachments: root.attachments;
                workspace-path: root.workspace-path;
                workspace-name: root.workspace-name;
                active-thread-id: root.active-thread-id;
                active-thread-title: root.active-thread-title;
                context-label: root.context-label;
                context-progress-path: root.context-progress-path;
                context-percent: root.context-percent;
                connected: root.connected;
                busy: root.busy;
                turn-elapsed-label: root.turn-elapsed-label;
                has-project: root.has-project;
                inspector-visible <=> root.inspector-visible;
                model-names: root.model-names;
                effort-names: root.effort-names;
                sandbox-names: root.sandbox-names;
                open-project-methods: root.open-project-methods;
                selected-model-index <=> root.selected-model-index;
                selected-effort-index <=> root.selected-effort-index;
                selected-sandbox-index <=> root.selected-sandbox-index;
                send-message(text) => { root.send-message(text); }
                stop-turn => { root.stop-turn(); }
                attach-files => { root.attach-files(); }
                paste-image => { root.paste-image() }
                remove-attachment(index) => { root.remove-attachment(index); }
                copy-code(text) => { root.copy-code(text); }
                copy-response(text) => { root.copy-response(text); }
                toggle-message(id) => { root.toggle-message(id); }
                toggle-response-details(id) => { root.toggle-response-details(id); }
                select-model(value) => { root.select-model(value); }
                select-effort(value) => { root.select-effort(value); }
                select-sandbox(value) => { root.select-sandbox(value); }
                open-project(value) => { root.open-project(value); }
            }

            if root.inspector-visible: InspectorPanel {
                files: root.files;
                changes: root.changes;
                activity: root.activity;
                workspace-name: root.workspace-name;
                change-count: root.change-count;
                staged-change-count: root.staged-change-count;
                unstaged-change-count: root.unstaged-change-count;
                selected-tab <=> root.inspector-tab;
                close => { root.inspector-visible = false; }
                refresh-workspace => { root.refresh-workspace(); }
            }
        }
    }

    if root.settings-visible: SettingsOverlay {
        model-names: root.model-names;
        default-effort-names: root.default-effort-names;
        summary-effort-names: root.summary-effort-names;
        sandbox-names: root.sandbox-names;
        approval-names: root.approval-names;
        default-model-index <=> root.default-model-index;
        default-effort-index <=> root.default-effort-index;
        default-sandbox-index <=> root.default-sandbox-index;
        selected-approval-index <=> root.selected-approval-index;
        summary-model-index <=> root.summary-model-index;
        summary-effort-index <=> root.summary-effort-index;
        visible-thread-limit <=> root.visible-thread-limit;
        show-all-threads <=> root.show-all-threads;
        respect-gitignore <=> root.respect-gitignore;
        account-label: root.account-label;
        plan-label: root.plan-label;
        usage-summary: root.usage-summary;
        reset-count: root.reset-count;
        reset-in-progress: root.reset-in-progress;
        close => { root.settings-visible = false; }
        select-default-model(value) => { root.select-default-model(value); }
        select-default-effort(value) => { root.select-default-effort(value); }
        select-default-sandbox(value) => { root.select-default-sandbox(value); }
        select-approval(value) => { root.select-approval(value); }
        select-summary-model(value) => { root.select-summary-model(value); }
        select-summary-effort(value) => { root.select-summary-effort(value); }
        set-visible-thread-limit(value) => { root.set-visible-thread-limit(value); }
        set-respect-gitignore(value) => { root.set-respect-gitignore(value); }
        refresh-usage => { root.refresh-usage(); }
        consume-reset => { root.consume-reset(); }
    }

    if root.approval-title != "": ApprovalOverlay {
        title: root.approval-title;
        detail: root.approval-detail;
        session: root.approval-session;
        answer(choice) => { root.answer-approval(choice); }
    }

    if root.questions.length > 0: QuestionsOverlay {
        questions: root.questions;
        answer-question(index, answer) => { root.answer-question(index, answer); }
        submit => { root.submit-question(); }
    }

    if root.toast-text != "": ToastOverlay {
        width: min(520px, parent.width - 40px);
        x: (parent.width - self.width) / 2;
        y: 55px;
        message: root.toast-text;
        error: root.toast-error;
    }

    if root.startup-loading: LoadingOverlay {
        y: 36px;
        height: parent.height - 36px;
    }
}
