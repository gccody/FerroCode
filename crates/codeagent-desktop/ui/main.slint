component FileTreeNode inherits Rectangle {
    in property <FileRow> node;
    in property <length> tree-origin: 13px;
    height: 26px;
    background: transparent;

    property <length> branch-x: node.depth * 16px + tree-origin;

    // Keep each open ancestor branch running behind nested descendants.
    if node.guide0: Rectangle { x: root.tree-origin; width: 1px; height: parent.height; background: #50525a; }
    if node.guide1: Rectangle { x: root.tree-origin + 16px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide2: Rectangle { x: root.tree-origin + 32px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide3: Rectangle { x: root.tree-origin + 48px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide4: Rectangle { x: root.tree-origin + 64px; width: 1px; height: parent.height; background: #50525a; }
    if node.guide5: Rectangle { x: root.tree-origin + 80px; width: 1px; height: parent.height; background: #50525a; }

    // Rust resolves the sibling relationship. The renderer only draws the
    // resulting connector, avoiding conditionals inside virtualized rows.
    Rectangle {
        x: root.branch-x;
        // Slint centers a shortened child vertically when y is implicit,
        // putting the stroke through both sides of the horizontal junction.
        y: 0px;
        width: 1px;
        height: root.node.connector-height * 1px;
        background: #50525a;
    }
    Rectangle { x: root.branch-x; y: 12px; width: 12px; height: 1px; background: #50525a; }

    Text {
        x: root.branch-x + 14px;
        width: parent.width - self.x;
        text: root.node.name;
        color: root.node.changed ? #ff8f9c : root.node.directory ? #dcdee4 : #aeb0b8;
        font-size: 10px;
        overflow: elide;
        vertical-alignment: TextVerticalAlignment.center;
    }
}

component InspectorTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    accessible-role: button;
    accessible-label: text;
    height: 30px;
    horizontal-stretch: 1;
    border-radius: 5px;
    background: selected ? #2c2740 : tab-touch.has-hover ? #24252a : transparent;
    Text {
        text: root.text;
        color: root.selected ? #ddd5ff : #9799a1;
        font-size: 9px;
        horizontal-alignment: TextHorizontalAlignment.center;
        vertical-alignment: TextVerticalAlignment.center;
    }
    Rectangle {
        visible: root.selected;
        x: 7px; y: parent.height - 2px;
        width: parent.width - 14px; height: 2px;
        border-radius: 1px;
        background: #8068cf;
    }
    tab-touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component MainWindow inherits Window {
    title: "CodeAgent";
    preferred-width: 1440px; preferred-height: 900px;
    min-width: 980px; min-height: 640px;
    background: #0d0e10;
    default-font-family: "Segoe UI";

    in property <[ProjectRow]> projects;
    in property <[ThreadRow]> threads;
    in property <[MessageRow]> messages;
    in property <[FileRow]> files;
    in property <[string]> activity;
    in property <[string]> model-names;
    in property <[string]> effort-names;
    in property <[string]> sandbox-names;
    in property <[string]> approval-names;
    in property <string> connection-text: "Starting Codex...";
    in property <bool> connected: false;
    in property <string> account-label: "";
    in property <string> plan-label: "";
    in property <string> workspace-path: "";
    in property <string> workspace-name: "Workspace";
    in property <string> active-thread-title: "New thread";
    in property <string> context-label: "";
    in property <string> usage-left-label: "";
    in property <int> context-percent: 0;
    in property <bool> busy: false;
    in property <bool> has-project: false;
    in-out property <bool> inspector-visible: false;
    in-out property <int> inspector-tab: 0;
    in-out property <bool> settings-visible: false;
    in-out property <bool> respect-gitignore: true;
    in property <string> git-diff: "";
    in-out property <int> selected-model-index: 0;
    in-out property <int> selected-effort-index: 0;
    in-out property <int> selected-sandbox-index: 1;
    in-out property <int> default-model-index: 0;
    in-out property <int> default-effort-index: 0;
    in property <[string]> default-effort-names: [];
    in-out property <int> default-sandbox-index: 1;
    in-out property <int> selected-approval-index: 0;
    in-out property <int> summary-model-index: 0;
    in-out property <int> summary-effort-index: 0;
    in property <[string]> summary-effort-names: [];
    in property <string> usage-summary: "Usage information unavailable";
    in property <int> reset-count: 0;
    in property <bool> reset-in-progress: false;
    in property <string> approval-title: "";
    in property <string> approval-detail: "";
    in property <bool> approval-session: false;
    in property <[QuestionRow]> questions;
    in property <[AttachmentRow]> attachments;
    in property <string> toast-text: "";
    in property <bool> toast-error: false;

    callback add-project;
    callback select-project(string);
    callback new-thread;
    callback open-thread(string);
    callback archive-thread(string);
    callback search-threads(string);
    callback send-message(string);
    callback stop-turn;
    callback attach-files;
    callback paste-image() -> bool;
    callback remove-attachment(int);
    callback copy-code(string);
    callback select-model(string);
    callback select-effort(string);
    callback select-sandbox(string);
    callback select-default-model(string);
    callback select-default-effort(string);
    callback select-default-sandbox(string);
    callback select-approval(string);
    callback select-summary-model(string);
    callback select-summary-effort(string);
    callback answer-approval(string);
    callback answer-question(int, string);
    callback submit-question;
    callback refresh-usage;
    callback consume-reset;
    callback set-inspector(bool);
    callback set-respect-gitignore(bool);

    changed inspector-visible => { root.set-inspector(root.inspector-visible); }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 47px;
            background: #0f1012;
            border-width: 1px;
            border-color: #292a2f;
            HorizontalLayout {
                padding-left: 11px; padding-right: 17px; spacing: 9px;
                BrandMark { y: (parent.height - self.height) / 2; }
                Text { text: "CodeAgent"; color: #f1f1f3; font-size: 14px; vertical-alignment: TextVerticalAlignment.center; }
                Rectangle { horizontal-stretch: 1; }
                if root.usage-left-label != "": Rectangle {
                    width: usage-text.preferred-width + 18px; height: 19px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 10px; background: #38393e;
                    usage-text := Text { text: root.usage-left-label; color: #f0f0f2; font-size: 11px; horizontal-alignment: TextHorizontalAlignment.center; vertical-alignment: TextVerticalAlignment.center; }
                }
                Rectangle { y: (parent.height - self.height) / 2; width: 8px; height: 8px; border-radius: 4px; background: root.connected ? #55d49a : #d6a54b; }
                Text { text: root.connection-text; color: #a0a2aa; font-size: 11px; vertical-alignment: TextVerticalAlignment.center; }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 247px;
                background: #0f1012;
                border-width: 1px;
                border-color: #292a2f;
                VerticalLayout {
                    padding-left: 4px; padding-right: 7px; padding-top: 9px; padding-bottom: 4px;
                    spacing: 7px;

                    FlatButton { text: "New chat"; plus-icon: true; enabled: root.has-project; clicked => { root.new-thread(); } }
                    LineEdit { height: 28px; placeholder-text: "Search"; edited(text) => { root.search-threads(text); } }
                    Rectangle { height: 14px; }
                    HorizontalLayout {
                        height: 22px;
                        Text { text: "Projects"; color: #9799a1; font-size: 12px; vertical-alignment: TextVerticalAlignment.center; }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle {
                            width: 19px;
                            MenuMark { x: 2px; y: (parent.height - self.height) / 2; }
                        }
                        Rectangle {
                            width: 24px;
                            PlusMark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            add-project-touch := TouchArea { mouse-cursor: pointer; clicked => { root.add-project(); } }
                        }
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        viewport-width: 230px;
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            width: 230px;
                            spacing: 2px;
                            for project in root.projects: VerticalLayout {
                                spacing: 1px;
                                Rectangle {
                                    height: 38px;
                                    border-radius: 6px;
                                    background: project-touch.has-hover ? #1b1c20 : transparent;
                                    ChevronDown { x: 5px; y: 15px; }
                                    Text { x: 77px; width: parent.width - 106px; text: project.name; color: #e8e8eb; font-size: 12px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
                                    ExternalMark { x: parent.width - 23px; y: 12px; }
                                    project-touch := TouchArea { mouse-cursor: pointer; clicked => { root.select-project(project.id); } }
                                }
                                for thread in root.threads: Rectangle {
                                    visible: thread.project-id == project.id;
                                    height: 42px;
                                    x: 17px;
                                    width: 213px;
                                    border-radius: 7px;
                                    background: thread.active ? #202126 : thread-touch.has-hover ? #18191c : transparent;
                                    Rectangle { x: -9px; width: 1px; height: parent.height; background: #303138; }
                                    Text { x: 20px; width: parent.width - (thread.active ? 48px : 28px); text: thread.title; color: thread.active ? #f0f0f2 : #9a9ca4; font-size: 12px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
                                    if thread.busy: Spinner { x: parent.width - 22px; y: 14px; width: 13px; height: 13px; }
                                    thread-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-thread(thread.id); } }
                                    if thread.active && !thread.busy: Rectangle {
                                        x: parent.width - 33px; y: 7px; width: 26px; height: 28px;
                                        border-radius: 5px; background: close-touch.has-hover ? #34353a : transparent;
                                        CloseMark { x: 7px; y: 8px; }
                                        close-touch := TouchArea { mouse-cursor: pointer; clicked => { root.archive-thread(thread.id); } }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: #292a2f; }
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: settings-touch.has-hover ? #1d1e22 : transparent;
                        HorizontalLayout {
                            alignment: LayoutAlignment.center;
                            spacing: 10px;
                            SettingsCog { y: (parent.height - self.height) / 2; }
                            Text { text: "Settings"; color: #d7d8dc; font-size: 13px; vertical-alignment: TextVerticalAlignment.center; }
                        }
                        settings-touch := TouchArea { mouse-cursor: pointer; clicked => { root.settings-visible = true; } }
                    }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                background: #0d0e10;
                VerticalLayout {
                    spacing: 0px;

                    Rectangle {
                        height: 57px;
                        background: #0d0e10;
                        border-width: 1px;
                        border-color: #292a2f;
                        HorizontalLayout {
                            padding-left: 20px; padding-right: 17px; spacing: 8px;
                            Text { text: root.active-thread-title; color: #f3f3f5; font-size: 15px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: root.workspace-path; color: #8d8f97; font-size: 10px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
                            Rectangle {
                                width: 32px; height: 30px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 7px;
                                background: root.inspector-visible ? #2c2740 : inspector-touch.has-hover ? #24252a : #191a1e;
                                border-width: 1px;
                                border-color: root.inspector-visible ? #5b4b8d : #34363d;
                                accessible-role: button;
                                accessible-label: root.inspector-visible ? "Hide inspector" : "Show inspector";
                                InspectorMark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                inspector-touch := TouchArea { mouse-cursor: pointer; clicked => { root.inspector-visible = !root.inspector-visible; } }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        background: #0d0e10;
                        if root.messages.length == 0: VerticalLayout {
                            padding-left: 80px; padding-right: 80px;
                            alignment: LayoutAlignment.center; spacing: 10px;
                            HorizontalLayout {
                                height: 34px;
                                horizontal-stretch: 1;
                                alignment: LayoutAlignment.center;
                                BrandMark { width: 34px; height: 34px; border-radius: 17px; }
                            }
                            Text { text: "What should we build?"; color: #ededf0; font-size: 22px; horizontal-alignment: TextHorizontalAlignment.center; }
                            Text { text: root.has-project ? "Ask CodeAgent to work in this project" : "Add a project folder to start"; color: #858790; font-size: 12px; horizontal-alignment: TextHorizontalAlignment.center; }
                        }
                        if root.messages.length > 0: Rectangle {
                            conversation := ListView {
                                x: max(16px, (parent.width - 850px) / 2);
                                width: min(parent.width - 32px, 850px);
                                height: parent.height;
                                vertical-scrollbar-policy: as-needed;
                                horizontal-scrollbar-policy: always-off;
                                for message in root.messages: MessageCard {
                                    message: message;
                                    copy-code(text) => { root.copy-code(text); }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: root.attachments.length > 0 ? 210px : 132px;
                        background: #0d0e10;
                        border-width: 1px;
                        border-color: #292a2f;
                        composer-shell := Rectangle {
                            width: min(parent.width - 38px, 820px);
                            height: root.attachments.length > 0 ? 194px : 116px;
                            x: (parent.width - self.width) / 2;
                            y: 8px;
                            background: #17181d;
                            border-width: 1px;
                            border-color: #303138;
                            border-radius: 14px;
                            composer := ComposerEdit {
                                x: 13px; y: 10px; width: parent.width - 26px; height: 59px;
                                enabled: root.connected && root.has-project && !root.busy;
                                placeholder-text: !root.has-project ? "Add a project folder before starting a thread" : root.connected ? "Ask for a follow-up or describe a task" : "Waiting for Codex CLI...";
                                key-pressed(event) => {
                                    if event.modifiers.control && (event.text == "v" || event.text == "V") {
                                        if root.paste-image() { return accept; }
                                        return reject;
                                    }
                                    if event.text == "\n" && !event.modifiers.shift {
                                        if composer.text != "" { root.send-message(composer.text); composer.text = ""; }
                                        return accept;
                                    }
                                    return reject;
                                }
                            }
                            if root.attachments.length > 0: ScrollView {
                                x: 12px; y: 72px; width: parent.width - 24px; height: 74px;
                                horizontal-scrollbar-policy: as-needed;
                                vertical-scrollbar-policy: always-off;
                                HorizontalLayout {
                                    spacing: 8px;
                                    for attachment in root.attachments: AttachmentPreview {
                                        attachment: attachment;
                                        remove(index) => { root.remove-attachment(index); }
                                    }
                                }
                            }
                            HorizontalLayout {
                                x: 12px; y: root.attachments.length > 0 ? 153px : 75px; width: parent.width - 24px; height: 31px; spacing: 7px;
                                Rectangle {
                                    width: 82px; height: 30px;
                                    border-radius: 7px;
                                    background: attach-touch.has-hover ? #35363c : #26272c;
                                    border-width: 1px; border-color: #35373d;
                                    PaperclipMark { x: 9px; y: (parent.height - self.height) / 2; }
                                    Text {
                                        x: 32px; width: parent.width - 39px;
                                        text: "Attach";
                                        color: #d0d1d6;
                                        font-size: 12px; vertical-alignment: TextVerticalAlignment.center; overflow: elide;
                                    }
                                    attach-touch := TouchArea { enabled: root.has-project; mouse-cursor: root.has-project ? pointer : default; clicked => { root.attach-files(); } }
                                }
                                ComboBox { width: 136px; model: root.model-names; current-index <=> root.selected-model-index; selected(value) => { root.select-model(value); } }
                                ComboBox { width: 99px; model: root.effort-names; current-index <=> root.selected-effort-index; selected(value) => { root.select-effort(value); } }
                                ComboBox { width: 98px; model: root.sandbox-names; current-index <=> root.selected-sandbox-index; selected(value) => { root.select-sandbox(value); } }
                                Rectangle { horizontal-stretch: 1; }
                                if root.busy: SmallButton { width: 58px; text: "Stop"; danger: true; clicked => { root.stop-turn(); } }
                                if !root.busy: Rectangle {
                                    width: 20px; height: 20px; border-radius: 10px;
                                    y: (parent.height - self.height) / 2;
                                    border-width: 2px; border-color: #30323a; background: transparent;
                                }
                                if !root.busy: Rectangle {
                                    width: 31px; height: 31px; border-radius: 16px;
                                    background: send-touch.has-hover ? #765dcc : #654db9;
                                    SendMark { x: (parent.width - self.width) / 2 + 0.5px; y: (parent.height - self.height) / 2; }
                                    send-touch := TouchArea { enabled: root.connected && root.has-project; mouse-cursor: pointer; clicked => { if composer.text != "" { root.send-message(composer.text); composer.text = ""; } } }
                                }
                            }
                        }
                    }
                }
            }

            if root.inspector-visible: Rectangle {
                width: 288px;
                background: #0f1012;
                border-width: 1px; border-color: #292a2f;
                VerticalLayout {
                    padding: 12px; spacing: 9px;
                    HorizontalLayout {
                        SectionTitle { text: "INSPECTOR"; }
                        Rectangle { horizontal-stretch: 1; }
                        Rectangle { width: 28px; height: 28px; border-radius: 5px; background: inspector-close.has-hover ? #34353a : transparent; CloseMark { x: 8px; y: 8px; } inspector-close := TouchArea { mouse-cursor: pointer; clicked => { root.inspector-visible = false; } } }
                    }
                    Rectangle { height: 1px; background: #292a2f; }
                    HorizontalLayout {
                        spacing: 3px;
                        InspectorTab { text: "Workspace"; selected: root.inspector-tab == 0; clicked => { root.inspector-tab = 0; } }
                        InspectorTab { text: "Changes"; selected: root.inspector-tab == 1; clicked => { root.inspector-tab = 1; } }
                        InspectorTab { text: "Files"; selected: root.inspector-tab == 2; clicked => { root.inspector-tab = 2; } }
                        InspectorTab { text: "Activity"; selected: root.inspector-tab == 3; clicked => { root.inspector-tab = 3; } }
                    }
                    if root.inspector-tab == 0: Rectangle {
                        vertical-stretch: 1;
                        Text { width: parent.width; text: root.workspace-path; color: #858790; font-size: 9px; wrap: word-wrap; }
                    }
                    if root.inspector-tab == 1: ScrollView {
                        vertical-stretch: 1;
                        Text { width: parent.width; text: root.git-diff == "" ? "Working tree clean" : root.git-diff; color: #a8a9af; font-family: "Cascadia Mono"; font-size: 9px; wrap: word-wrap; }
                    }
                    if root.inspector-tab == 2: Rectangle {
                        vertical-stretch: 1;
                        root-node-label := Text {
                            x: 1px; y: 0px;
                            width: parent.width - 2px;
                            height: 22px;
                            text: root.workspace-name;
                            color: #eeeaff;
                            font-size: 10px;
                            font-weight: 600;
                            overflow: elide;
                            vertical-alignment: TextVerticalAlignment.center;
                        }
                        if root.files.length > 0: Rectangle {
                            x: 8px;
                            y: 19px; width: 1px; height: 8px; background: #50525a;
                        }
                        ListView {
                            x: 1px; y: 26px;
                            width: parent.width - 2px;
                            height: parent.height - 26px;
                            for file in root.files: FileTreeNode {
                                node: file;
                                tree-origin: 7px;
                            }
                        }
                    }
                    if root.inspector-tab == 3: ListView {
                        vertical-stretch: 1;
                        for entry in root.activity: Text { height: 21px; text: entry; color: #7d7f87; font-size: 9px; overflow: elide; }
                    }
                }
            }
        }
    }

    if root.settings-visible: Rectangle {
        background: #99000000;
        TouchArea { clicked => { root.settings-visible = false; } }
        Rectangle {
            width: 520px; height: min(parent.height - 30px, 690px);
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #18191d; border-width: 1px; border-color: #363840; border-radius: 13px;
            VerticalLayout {
                padding: 20px; spacing: 13px;
                HorizontalLayout {
                    Text { text: "Settings"; color: #f0f0f2; font-size: 20px; }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle { width: 34px; height: 30px; border-radius: 6px; background: settings-close.has-hover ? #34353a : #26272c; CloseMark { x: 11px; y: 9px; } settings-close := TouchArea { mouse-cursor: pointer; clicked => { root.settings-visible = false; } } }
                }
                settings-body-scroll := ScrollView {
                    vertical-stretch: 1;
                    viewport-width: self.width;
                    horizontal-scrollbar-policy: always-off;
                    VerticalLayout {
                        width: settings-body-scroll.width;
                        spacing: 13px;
                        SectionTitle { text: "AGENT DEFAULTS"; color: #a995ff; }
                        Text { text: "Model"; color: #c9cad0; font-size: 11px; }
                        ComboBox { model: root.model-names; current-index <=> root.default-model-index; selected(value) => { root.select-default-model(value); } }
                        Text { text: "Reasoning effort"; color: #c9cad0; font-size: 11px; }
                        ComboBox { model: root.default-effort-names; current-index <=> root.default-effort-index; selected(value) => { root.select-default-effort(value); } }
                        Text { text: "Workspace permissions"; color: #c9cad0; font-size: 11px; }
                        ComboBox { model: root.sandbox-names; current-index <=> root.default-sandbox-index; selected(value) => { root.select-default-sandbox(value); } }
                        Text { text: "Approval policy"; color: #c9cad0; font-size: 11px; }
                        ComboBox { model: root.approval-names; current-index <=> root.selected-approval-index; selected(value) => { root.select-approval(value); } }
                        Rectangle { height: 1px; background: #2b2d33; }
                        SectionTitle { text: "FILES INSPECTOR"; color: #a995ff; }
                        Rectangle {
                            height: 43px;
                            Text {
                                x: 0px; y: 0px; height: 18px;
                                text: "Respect .gitignore";
                                color: #c9cad0;
                                font-size: 11px;
                                vertical-alignment: TextVerticalAlignment.center;
                            }
                            Text {
                                x: 0px; y: 20px; width: parent.width - 55px; height: 18px;
                                text: "Hide files matched by repository ignore rules.";
                                color: #858790;
                                font-size: 10px;
                                overflow: elide;
                                vertical-alignment: TextVerticalAlignment.center;
                            }
                            ToggleSwitch {
                                x: parent.width - self.width;
                                y: 4px;
                                checked: root.respect-gitignore;
                                label: "Respect .gitignore";
                                toggled(value) => {
                                    root.respect-gitignore = value;
                                    root.set-respect-gitignore(value);
                                }
                            }
                        }
                        Rectangle { height: 1px; background: #2b2d33; }
                        SectionTitle { text: "SUMMARIES"; color: #a995ff; }
                        Text { text: "Summary model"; color: #c9cad0; font-size: 11px; }
                        ComboBox { model: root.model-names; current-index <=> root.summary-model-index; selected(value) => { root.select-summary-model(value); } }
                        Text { text: "Summary effort"; color: #c9cad0; font-size: 11px; }
                        ComboBox { model: root.summary-effort-names; current-index <=> root.summary-effort-index; selected(value) => { root.select-summary-effort(value); } }
                        Rectangle { height: 1px; background: #2b2d33; }
                        SectionTitle { text: "CODEX ACCOUNT"; color: #a995ff; }
                        Text { text: root.account-label == "" ? "Account information unavailable" : root.account-label + (root.plan-label != "" ? " - " + root.plan-label : ""); color: #c9cad0; font-size: 11px; }
                        Text { text: root.usage-summary; color: #91939b; font-size: 10px; wrap: word-wrap; }
                        HorizontalLayout {
                            SmallButton { width: 110px; text: "Refresh usage"; clicked => { root.refresh-usage(); } }
                            if root.reset-count > 0: SmallButton { width: 120px; text: root.reset-in-progress ? "Resetting..." : "Use reset (" + root.reset-count + ")"; primary: true; enabled: !root.reset-in-progress; clicked => { root.consume-reset(); } }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }
    }

    if root.approval-title != "": Rectangle {
        background: #aa000000;
        Rectangle {
            width: 560px; height: 350px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #18191d; border-width: 1px; border-color: #4a3f73; border-radius: 13px;
            VerticalLayout {
                padding: 20px; spacing: 13px;
                Text { text: root.approval-title; color: #f1f1f3; font-size: 19px; }
                ScrollView { vertical-stretch: 1; Text { width: parent.width; text: root.approval-detail; color: #b9bbc2; font-family: "Cascadia Mono"; font-size: 11px; wrap: word-wrap; } }
                HorizontalLayout {
                    SmallButton { width: 76px; text: "Deny"; danger: true; clicked => { root.answer-approval("decline"); } }
                    Rectangle { horizontal-stretch: 1; }
                    if root.approval-session: SmallButton { width: 126px; text: "Allow session"; clicked => { root.answer-approval("acceptForSession"); } }
                    SmallButton { width: 86px; text: "Allow once"; primary: true; clicked => { root.answer-approval("accept"); } }
                }
            }
        }
    }

    if root.questions.length > 0: Rectangle {
        background: #aa000000;
        Rectangle {
            width: 560px; height: 410px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: #18191d; border-width: 1px; border-color: #4a3f73; border-radius: 13px;
            VerticalLayout {
                padding: 20px; spacing: 12px;
                Text { text: "Codex needs your input"; color: #f1f1f3; font-size: 19px; }
                ListView {
                    vertical-stretch: 1;
                    for question in root.questions: Rectangle {
                        height: question.option-count > 0 ? 166px : 112px;
                        VerticalLayout {
                            spacing: 6px;
                            Text { text: question.header; color: #a995ff; font-size: 11px; }
                            Text { text: question.question; color: #b9bbc2; font-size: 12px; wrap: word-wrap; }
                            if question.option-count > 0: HorizontalLayout {
                                height: 34px; spacing: 6px;
                                SmallButton { horizontal-stretch: 1; text: question.option-a; selected: question.answer == question.option-a; clicked => { root.answer-question(question.index, question.option-a); } }
                                if question.option-count > 1: SmallButton { horizontal-stretch: 1; text: question.option-b; selected: question.answer == question.option-b; clicked => { root.answer-question(question.index, question.option-b); } }
                                if question.option-count > 2: SmallButton { horizontal-stretch: 1; text: question.option-c; selected: question.answer == question.option-c; clicked => { root.answer-question(question.index, question.option-c); } }
                            }
                            LineEdit {
                                placeholder-text: question.option-count > 0 ? "Or type another answer" : "Type an answer";
                                input-type: question.secret ? password : text;
                                text: question.answer;
                                edited(text) => { root.answer-question(question.index, text); }
                            }
                        }
                    }
                }
                HorizontalLayout { Rectangle { horizontal-stretch: 1; } SmallButton { width: 92px; text: "Continue"; primary: true; clicked => { root.submit-question(); } } }
            }
        }
    }

    if root.toast-text != "": Rectangle {
        width: min(520px, parent.width - 40px); height: 42px;
        x: (parent.width - self.width) / 2; y: 55px;
        border-radius: 8px;
        background: root.toast-error ? #4a2229 : #1f3b31;
        border-width: 1px; border-color: root.toast-error ? #f26270 : #4ccd91;
        Text { x: 13px; width: parent.width - 26px; text: root.toast-text; color: #f2f2f4; font-size: 11px; vertical-alignment: TextVerticalAlignment.center; overflow: elide; }
    }
}
