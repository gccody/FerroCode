import { ScrollView, Spinner } from "std-widgets.slint";
import { MessageRow } from "types.slint";
import { CopyMark } from "icons.slint";

export component MessageCard inherits Rectangle {
    in property <MessageRow> message;
    callback copy-code(string);
    callback copy-response(string);
    callback toggle-message(string);
    callback toggle-response-details(string);
    horizontal-stretch: 1;
    height: message.activity && !message.collapsed && message.body != ""
        ? activity-body.preferred-height + 44px
        : message.row-height;
    background: transparent;

    if message.user: Rectangle {
        // Use the renderer's proportional-font measurement so every bubble
        // has exactly 14 px of horizontal padding, including short messages.
        width: min(bubble-text.preferred-width + 28px, min(650px, parent.width - 18px));
        height: parent.height - 10px;
        x: parent.width - self.width - 8px;
        y: 5px;
        border-radius: 14px;
        background: #222226;
        border-width: 1px;
        border-color: #303137;
        bubble-text := Text {
            x: 14px; y: 8px; width: parent.width - 28px; height: parent.height - 16px;
            text: message.body;
            color: #e8e8eb;
            font-size: 13px;
            wrap: word-wrap;
            vertical-alignment: TextVerticalAlignment.center;
        }
    }

    if message.activity: Rectangle {
        x: 8px; width: parent.width - 16px; height: 38px;
        border-radius: 5px;
        background: activity-touch.has-hover ? #23242a : transparent;
        accessible-role: button;
        accessible-label: (message.collapsed ? "Expand " : "Collapse ") + message.title;
        Path {
            x: 6px; y: 13px; width: 11px; height: 12px;
            commands: message.collapsed ? "M 2 1 L 6 5 L 2 9" : "M 1 2 L 4.5 6 L 8 2";
            viewbox-width: 10; viewbox-height: 10;
            fill: transparent; stroke: #9a9ca4; stroke-width: 1.7px;
            stroke-line-cap: round; stroke-line-join: round;
        }
        Text {
            x: 26px; y: 0px; width: parent.width - 74px; height: 38px;
            text: message.title;
            color: activity-touch.has-hover ? #d0d1d6 : #989aa2;
            font-size: 12px;
            vertical-alignment: TextVerticalAlignment.center; overflow: elide;
        }
        if message.status == "running": Spinner { x: parent.width - 25px; y: 12px; width: 14px; height: 14px; }
        activity-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-message(message.id); }
        }
    }

    activity-body := Text {
        visible: message.activity && !message.collapsed && message.body != "";
        x: 34px; y: 38px; width: parent.width - 58px;
        height: self.preferred-height;
        text: message.body;
        color: #c5c5cb;
        font-family: message.kind == "command" ? "Cascadia Mono" : "Segoe UI";
        font-size: 12px;
        wrap: word-wrap;
        vertical-alignment: TextVerticalAlignment.top;
    }

    if message.response-summary: Rectangle {
        x: 8px; width: parent.width - 16px; height: parent.height;
        summary-label := Text {
            x: 0px; y: 0px; width: self.preferred-width; height: parent.height - 1px;
            text: message.title;
            color: #8f919a;
            font-size: 11px;
            vertical-alignment: TextVerticalAlignment.center;
        }
        Path {
            x: min(summary-label.preferred-width + 8px, parent.width - 16px);
            y: 18px; width: 9px; height: 9px;
            commands: message.collapsed ? "M 2 1 L 6 5 L 2 9" : "M 1 2 L 4.5 6 L 8 2";
            viewbox-width: 10; viewbox-height: 10;
            fill: transparent; stroke: #858790; stroke-width: 1.5px;
            stroke-line-cap: round; stroke-line-join: round;
        }
        Rectangle {
            x: 0px; y: parent.height - 1px; width: parent.width; height: 1px;
            background: #222329;
        }
        accessible-role: button;
        accessible-label: (message.collapsed ? "Expand " : "Collapse ") + message.title;
        summary-touch := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.toggle-response-details(message.response-id); }
        }
    }

    if !message.user && !message.activity && !message.response-summary: VerticalLayout {
        padding-left: 8px; padding-right: 8px; padding-top: 5px; padding-bottom: 5px;
        spacing: 7px;

        for block in message.markdown-blocks: Rectangle {
            height: block.block-height;
            background: transparent;

            if block.kind == "paragraph": TextInput {
                width: parent.width; height: parent.height;
                text: block.raw-text;
                read-only: true; single-line: false; wrap: word-wrap;
                color: message.kind == "reasoning" ? #aaabb2 : #f0f0f2;
                font-size: message.kind == "reasoning" ? 12px : 13px;
                selection-background-color: #7658db;
                selection-foreground-color: #ffffff;
                accessible-label: block.raw-text;
            }

            if block.kind == "heading": TextInput {
                width: parent.width; height: parent.height;
                text: block.raw-text;
                read-only: true; single-line: false; wrap: word-wrap;
                color: #f4f2fa;
                font-size: block.level == 1 ? 22px : block.level == 2 ? 19px : block.level == 3 ? 17px : block.level == 4 ? 15px : 14px;
                font-weight: 600;
                vertical-alignment: TextVerticalAlignment.center;
                selection-background-color: #7658db;
                selection-foreground-color: #ffffff;
                accessible-label: block.raw-text;
            }

            if block.kind == "quote": Rectangle {
                width: parent.width; height: parent.height;
                background: #14151a;
                border-radius: 4px;
                Rectangle { x: 0px; width: 3px; height: parent.height; border-radius: 2px; background: #6f5bb4; }
                TextInput {
                    x: 13px; y: 7px; width: parent.width - 22px; height: parent.height - 14px;
                    text: block.raw-text;
                    read-only: true; single-line: false; wrap: word-wrap;
                    color: #bbb9c3;
                    font-size: message.kind == "reasoning" ? 12px : 13px;
                    selection-background-color: #7658db;
                    selection-foreground-color: #ffffff;
                    accessible-label: block.raw-text;
                }
            }

            if block.kind == "code": Rectangle {
                width: parent.width; height: parent.height;
                background: #17181d;
                border-width: 1px; border-color: #303138; border-radius: 6px;
                Text {
                    x: 10px; y: 1px; width: parent.width - 54px; height: 32px;
                    text: block.language;
                    color: #8f919a;
                    font-family: "Cascadia Mono";
                    font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                    overflow: elide;
                }
                Rectangle {
                    x: parent.width - 35px; y: 5px; width: 28px; height: 24px;
                    border-radius: 5px;
                    background: copy-touch.has-hover ? #303138 : transparent;
                    border-width: 1px;
                    border-color: copy-touch.has-hover ? #474951 : transparent;
                    accessible-role: button;
                    accessible-label: "Copy code";
                    CopyMark { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                    copy-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.copy-code(block.raw-text); }
                    }
                }
                Rectangle { x: 1px; y: 33px; width: parent.width - 2px; height: 1px; background: #292a30; }
                TextInput {
                    x: 10px; y: 35px; width: parent.width - 20px; height: parent.height - 42px;
                    text: block.raw-text;
                    color: #d7d5de;
                    font-family: "Cascadia Mono";
                    font-size: 12px;
                    wrap: word-wrap;
                    single-line: false;
                    read-only: true;
                    selection-background-color: #7658db;
                    selection-foreground-color: #ffffff;
                    vertical-alignment: TextVerticalAlignment.top;
                    accessible-label: block.raw-text;
                }
            }

            if block.kind == "rule": Rectangle {
                y: (parent.height - 1px) / 2; width: parent.width; height: 1px; background: #34353b;
            }

            if block.kind == "table": ScrollView {
                width: parent.width; height: parent.height;
                viewport-width: block.table-width;
                viewport-height: block.table-height;
                horizontal-scrollbar-policy: as-needed;
                vertical-scrollbar-policy: always-off;
                Rectangle {
                    width: block.table-width; height: block.table-height;
                    border-width: 1px; border-color: #393a42; border-radius: 10px;
                    clip: true;
                    VerticalLayout {
                        spacing: 0px;
                        for row[row-index] in block.table-rows: HorizontalLayout {
                            height: row.row-height;
                            spacing: 0px;
                            for cell[cell-index] in row.cells: Rectangle {
                                width: cell.column-width;
                                horizontal-stretch: 0;
                                border-width: 1px;
                                border-color: #393a42;
                                border-top-left-radius: row-index == 0 && cell-index == 0 ? 10px : 0px;
                                border-top-right-radius: row-index == 0 && cell-index == row.cells.length - 1 ? 10px : 0px;
                                border-bottom-left-radius: row-index == block.table-rows.length - 1 && cell-index == 0 ? 10px : 0px;
                                border-bottom-right-radius: row-index == block.table-rows.length - 1 && cell-index == row.cells.length - 1 ? 10px : 0px;
                                background: row.header ? #24212f : #15161a;
                                TextInput {
                                    x: 8px; y: 6px; width: parent.width - 16px; height: parent.height - 12px;
                                    text: cell.raw-text;
                                    read-only: true; single-line: false; wrap: word-wrap;
                                    color: row.header ? #f0ecff : #d2d2d7;
                                    font-size: 12px;
                                    font-weight: row.header ? 600 : 400;
                                    horizontal-alignment: cell.alignment == "center" ? TextHorizontalAlignment.center : cell.alignment == "right" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left;
                                    vertical-alignment: TextVerticalAlignment.center;
                                    selection-background-color: #7658db;
                                    selection-foreground-color: #ffffff;
                                    accessible-label: cell.raw-text;
                                }
                            }
                        }
                    }
                }
            }
        }

        if message.kind == "assistant" && message.duration-label != "": HorizontalLayout {
            height: 28px;
            alignment: LayoutAlignment.end;
            Rectangle {
                width: 72px; height: 28px;
                border-radius: 6px;
                background: response-copy-touch.has-hover ? #26272d : transparent;
                border-width: 1px;
                border-color: response-copy-touch.has-hover ? #42434b : transparent;
                accessible-role: button;
                accessible-label: "Copy response";
                CopyMark { x: 9px; y: 7px; width: 14px; height: 14px; }
                Text {
                    x: 29px; width: 35px; height: parent.height;
                    text: "Copy"; color: #aeb0b8; font-size: 11px;
                    vertical-alignment: TextVerticalAlignment.center;
                }
                response-copy-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.copy-response(message.body); }
                }
            }
        }

    }
}
