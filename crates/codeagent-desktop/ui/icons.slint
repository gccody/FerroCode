export component BrandMark inherits Rectangle {
    width: 18px; height: 18px;
    border-radius: 9px;
    border-width: 2px;
    border-color: #7658db;
    Rectangle { width: 5px; height: 5px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-radius: 3px; background: #a893ff; }
}

export component CompletedMark inherits Rectangle {
    width: 14px; height: 14px;
    border-radius: 7px;
    background: #3f9f72;
    Path {
        x: 3px; y: 3px; width: 8px; height: 8px;
        commands: "M 1 4 L 3.2 6.2 L 7 1.8";
        viewbox-width: 8; viewbox-height: 8;
        fill: transparent; stroke: #ffffff; stroke-width: 1.5px;
        stroke-line-cap: round; stroke-line-join: round;
    }
}

// The native Spinner can become effectively invisible with the dark Skia
// palette, so sidebar activity uses an explicit high-contrast status badge.
export component WorkingMark inherits Rectangle {
    width: 16px; height: 16px;
    border-radius: 8px;
    background: #392d63;
    border-width: 1px;
    border-color: #a893ff;
    Rectangle {
        x: 4px; y: 4px; width: 8px; height: 8px;
        border-radius: 4px;
        background: #c7baff;
    }
}

export component PlusMark inherits Path {
    width: 14px; height: 14px;
